<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Chiến Binh Không Gian - Buồng Lái Chiến Thuật Widescreen</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&family=Chakra+Petch:ital,wght@0,600;0,700;0,800;1,700&display=swap" rel="stylesheet">
    <style>
        :root {
            --font-display: 'Chakra Petch', 'Be Vietnam Pro', sans-serif;
            --font-body: 'Be Vietnam Pro', sans-serif;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            background-color: #030613;
            color: #f8fafc;
            font-family: var(--font-body);
            overflow: hidden;
            touch-action: none;
            -webkit-font-smoothing: antialiased;
        }

        .font-display {
            font-family: var(--font-display);
        }

        /* Bố cục Buồng Lái Ngang 2 Khung (Landscape Tablet & Laptop Cockpit) */
        #cockpit-wrapper {
            display: flex;
            flex-direction: row;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: radial-gradient(circle at 65% 50%, #09122c 0%, #030612 100%);
        }

        /* Cột Chỉ Huy Bên Trái (Command Sidebar) */
        #command-sidebar {
            width: 320px;
            min-width: 280px;
            max-width: 340px;
            height: 100vh;
            background: linear-gradient(180deg, rgba(8, 15, 36, 0.98) 0%, rgba(5, 9, 22, 0.99) 100%);
            border-right: 2px solid rgba(0, 243, 255, 0.28);
            box-shadow: 6px 0 28px rgba(0, 0, 0, 0.75), inset -1px 0 12px rgba(0, 243, 255, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 10px 12px;
            z-index: 30;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #0284c7 #080f24;
        }

        /* Tự động thu gọn vừa vặn nếu màn hình nhỏ nhưng vẫn giữ nguyên 2 khung ngang */
        @media (max-width: 760px) {
            #command-sidebar {
                width: 235px;
                min-width: 215px;
                padding: 6px 8px;
            }
        }

        /* Chiến Trường Không Gian Chiều Ngang Bên Phải */
        #battlefield-stage {
            flex: 1;
            position: relative;
            height: 100vh;
            overflow: hidden;
            background: #02040a;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* Card chọn nhanh Chiến Cơ & Đạn */
        .tactical-card {
            background: rgba(15, 23, 42, 0.75);
            border: 1.5px solid rgba(56, 189, 248, 0.22);
            border-radius: 8px;
            transition: all 0.16s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        .tactical-card:hover {
            border-color: rgba(0, 243, 255, 0.65);
            background: rgba(14, 34, 64, 0.85);
            transform: translateY(-1px);
        }
        .tactical-card.active {
            background: linear-gradient(135deg, rgba(6, 78, 119, 0.65) 0%, rgba(15, 23, 42, 0.92) 100%);
            border-color: #00f3ff;
            box-shadow: 0 0 12px rgba(0, 243, 255, 0.35), inset 0 0 8px rgba(0, 243, 255, 0.18);
        }

        .ammo-card.active {
            background: linear-gradient(135deg, rgba(120, 53, 15, 0.65) 0%, rgba(24, 24, 38, 0.95) 100%);
            border-color: #fbbf24;
            box-shadow: 0 0 12px rgba(251, 191, 36, 0.35), inset 0 0 8px rgba(251, 191, 36, 0.18);
        }

        /* Thanh máu và tiến trình */
        .bar-track {
            width: 100%;
            background: rgba(15, 23, 42, 0.9);
            border: 1.5px solid rgba(148, 163, 184, 0.35);
            border-radius: 999px;
            overflow: hidden;
            position: relative;
        }

        /* Overlay Màn Hình Chờ / Xưởng Chiến Cơ 2 Cột Ngang */
        .stage-overlay {
            position: absolute;
            inset: 0;
            background: rgba(3, 7, 19, 0.86);
            backdrop-filter: blur(6px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 40;
        }

        .hidden-overlay {
            display: none !important;
        }

        .cyber-btn {
            font-family: var(--font-display);
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            border-radius: 8px;
            transition: all 0.18s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .cyber-btn-primary {
            background: linear-gradient(90deg, #06b6d4 0%, #2563eb 100%);
            color: #ffffff;
            border: 1.5px solid #67e8f9;
            box-shadow: 0 0 18px rgba(6, 182, 212, 0.45);
        }
        .cyber-btn-primary:hover {
            transform: scale(1.03);
            box-shadow: 0 0 26px rgba(6, 182, 212, 0.85);
            filter: brightness(1.1);
        }

        .cyber-btn-secondary {
            background: rgba(15, 23, 42, 0.85);
            color: #38bdf8;
            border: 1.5px solid rgba(56, 189, 248, 0.45);
        }
        .cyber-btn-secondary:hover {
            background: rgba(30, 41, 59, 0.95);
            border-color: #00f3ff;
            color: #ffffff;
        }

        /* Cảnh báo giữa màn hình chiến trường */
        #center-banner {
            position: absolute;
            top: 42%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-family: var(--font-display);
            text-align: center;
            z-index: 25;
            pointer-events: none;
            display: none;
            width: 88%;
        }

        /* Custom Range Slider */
        input[type=range].cyber-slider {
            -webkit-appearance: none;
            width: 100%;
            height: 8px;
            background: #1e293b;
            border-radius: 6px;
            border: 1px solid #38bdf8;
            outline: none;
        }
        input[type=range].cyber-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #00f3ff;
            box-shadow: 0 0 10px #00f3ff;
            cursor: pointer;
            border: 2px solid #ffffff;
        }
    </style>
</head>
<body>

<div id="cockpit-wrapper">
    <!-- ==================== 1. CỘT CHỈ HUY BÊN TRÁI (COMMAND SIDEBAR - LUÔN HIỂN THỊ) ==================== -->
    <aside id="command-sidebar">
        <!-- Header & Trạng thái trận đấu -->
        <div>
            <div class="flex items-center justify-between border-b border-cyan-500/30 pb-1.5 mb-2">
                <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_#22d3ee]"></span>
                    <h2 class="font-display font-extrabold text-sm tracking-wider text-cyan-300 uppercase">BUỒNG LÁI CHỈ HUY</h2>
                </div>
                <span id="sidebar-state-badge" class="text-[10px] font-display font-bold px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">SẴN SÀNG</span>
            </div>

            <!-- Điểm số, Kỷ lục, Cấp độ -->
            <div class="grid grid-cols-3 gap-1.5 mb-2">
                <div class="bg-slate-900/90 border border-slate-700/80 rounded-lg p-1.5 text-center">
                    <div class="text-[10px] text-slate-400 font-semibold">ĐIỂM SỐ</div>
                    <div id="hud-score" class="font-display font-extrabold text-sm text-cyan-300 truncate">0</div>
                </div>
                <div class="bg-slate-900/90 border border-slate-700/80 rounded-lg p-1.5 text-center">
                    <div class="text-[10px] text-slate-400 font-semibold">KỶ LỤC</div>
                    <div id="hud-highscore" class="font-display font-extrabold text-sm text-amber-300 truncate">0</div>
                </div>
                <div class="bg-slate-900/90 border border-slate-700/80 rounded-lg p-1.5 text-center">
                    <div class="text-[10px] text-slate-400 font-semibold">CẤP ĐỘ</div>
                    <div id="hud-level" class="font-display font-extrabold text-sm text-emerald-300">1 / 10</div>
                </div>
            </div>

            <!-- Thanh Máu HP & Khiên Bảo Vệ -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-2 mb-2">
                <div class="flex justify-between items-center text-xs mb-1">
                    <span class="font-bold text-emerald-300 flex items-center gap-1">
                        <span>❤️ NĂNG LƯỢNG (HP)</span>
                    </span>
                    <span id="hud-hp-text" class="font-display font-bold text-white">100 / 100</span>
                </div>
                <div class="bar-track h-3 mb-2">
                    <div id="hud-hp-bar" class="h-full bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-150 shadow-[0_0_10px_#10b981]" style="width: 100%;"></div>
                </div>

                <!-- Khiên & Tiến trình diệt địch gọi Boss -->
                <div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-800/90">
                    <div class="flex items-center gap-1.5">
                        <span class="text-slate-400">KHIÊN:</span>
                        <span id="hud-shield-badge" class="font-display font-bold px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-400 border border-slate-700">CHƯA BẬT</span>
                    </div>
                    <div class="text-right">
                        <span class="text-slate-400">TIẾN ĐỘ TRÙM:</span>
                        <span id="hud-wave-text" class="font-display font-bold text-amber-300 ml-1">0/14</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4 Ô Chọn Nhanh Chiến Cơ (Aircraft Quick-Select) -->
        <div class="my-1">
            <div class="flex items-center justify-between mb-1">
                <span class="text-[11px] font-display font-bold text-cyan-300 uppercase tracking-wider">✈️ 4 CHIẾN CƠ (ĐỔI TRỰC TIẾP)</span>
                <span id="active-ship-label" class="text-[10px] text-sky-300 font-semibold">Chim Ưng</span>
            </div>
            <div class="grid grid-cols-2 gap-1.5" id="sidebar-ship-grid">
                <!-- Populated dynamically by JS -->
            </div>
        </div>

        <!-- 4 Ô Chọn Nhanh Loại Đạn (Ammo Quick-Select Keys 1-4) -->
        <div class="my-1">
            <div class="flex items-center justify-between mb-1">
                <span class="text-[11px] font-display font-bold text-amber-300 uppercase tracking-wider">🔥 4 LOẠI ĐẠN (PHÍM 1–4)</span>
                <div class="flex items-center gap-1">
                    <button id="tier-minus-btn" title="Giảm cấp đạn" class="w-5 h-5 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-bold text-cyan-300 flex items-center justify-center">-</button>
                    <span id="hud-weapon-tier" class="text-[11px] font-display font-extrabold text-yellow-300 px-1">CẤP 1/10</span>
                    <button id="tier-plus-btn" title="Tăng cấp đạn" class="w-5 h-5 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-bold text-cyan-300 flex items-center justify-center">+</button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-1.5" id="sidebar-ammo-grid">
                <!-- Populated dynamically by JS -->
            </div>
        </div>

        <!-- Nút điều khiển nhanh dưới cùng -->
        <div class="pt-1.5 border-t border-slate-800 flex flex-col gap-1.5">
            <button id="open-hangar-btn" class="cyber-btn cyber-btn-secondary w-full py-1.5 text-xs">
                <span>⚙️ XƯỞNG CHIẾN CƠ & CÀI ĐẶT (H)</span>
            </button>
            <div class="grid grid-cols-2 gap-1.5">
                <button id="pause-btn" class="cyber-btn cyber-btn-secondary py-1.5 text-xs">
                    <span id="pause-btn-text">⏸️ TẠM DỪNG (P)</span>
                </button>
                <button id="quick-restart-btn" class="cyber-btn cyber-btn-secondary py-1.5 text-xs text-rose-300 border-rose-500/40 hover:border-rose-400">
                    <span>🔄 CHƠI LẠI</span>
                </button>
            </div>
        </div>
    </aside>

    <!-- ==================== 2. CHIẾN TRƯỜNG KHÔNG GIAN CHIỀU NGANG BÊN PHẢI ==================== -->
    <main id="battlefield-stage">
        <canvas id="gameCanvas"></canvas>

        <!-- Thanh Máu Trùm Cuối (Boss HP Bar nổi phía trên Chiến Trường) -->
        <div id="boss-hud-overlay" class="hidden-overlay absolute top-3 left-1/2 -translate-x-1/2 w-[82%] max-w-2xl bg-slate-950/85 border-2 border-rose-500/80 rounded-xl px-4 py-2 shadow-[0_0_25px_rgba(244,63,94,0.45)] z-20 pointer-events-none">
            <div class="flex justify-between items-center mb-1">
                <span id="boss-title-text" class="font-display font-extrabold text-sm md:text-base text-rose-400 tracking-wider uppercase drop-shadow">🐔 GÀ CHÚA VŨ TRỤ - CẤP 1</span>
                <span id="boss-hp-numbers" class="font-display font-bold text-xs text-amber-300">550 / 550 HP</span>
            </div>
            <div class="bar-track h-3.5 border-rose-500/60">
                <div id="boss-hp-fill" class="h-full bg-gradient-to-r from-rose-600 via-red-500 to-amber-400 transition-all duration-100 shadow-[0_0_12px_#f43f5e]" style="width: 100%;"></div>
            </div>
        </div>

        <!-- Gợi ý phím tắt nhanh góc trên phải -->
        <div class="absolute top-2.5 right-3 z-10 pointer-events-none hidden lg:flex items-center gap-2 text-[11px] bg-slate-900/70 border border-slate-700/70 px-3 py-1 rounded-full text-slate-300">
            <span>Di chuyển: <strong class="text-cyan-300">WASD / Chuột / Chạm</strong></span>
            <span>•</span>
            <span>Đổi đạn: <strong class="text-amber-300">Phím 1–4</strong></span>
            <span>•</span>
            <span>Tạm dừng: <strong class="text-emerald-300">P</strong></span>
        </div>

        <!-- Banner cảnh báo giữa màn hình -->
        <div id="center-banner">
            <div id="center-banner-box" class="inline-block bg-slate-950/90 border-2 border-amber-400 px-8 py-4 rounded-2xl shadow-[0_0_35px_rgba(251,191,36,0.45)]">
                <div id="center-banner-title" class="font-display font-extrabold text-2xl md:text-3xl text-amber-300 tracking-wider uppercase">CẢNH BÁO!</div>
                <div id="center-banner-sub" class="text-sm md:text-base text-slate-200 mt-1 font-semibold">GÀ CHÚA XUẤT HIỆN</div>
            </div>
        </div>

        <!-- ==================== MÀN HÌNH CHỜ & XƯỞNG CHIẾN CƠ 2 CỘT NGANG ==================== -->
        <div id="start-hangar-modal" class="stage-overlay">
            <div class="w-full max-w-5xl max-h-[94vh] bg-slate-950/95 border-2 border-cyan-400/60 rounded-2xl shadow-[0_0_45px_rgba(0,243,255,0.25)] p-4 md:p-6 flex flex-col justify-between overflow-y-auto">
                
                <!-- Tiêu đề Modal -->
                <div class="flex flex-wrap items-center justify-between border-b border-slate-800 pb-3 mb-3 gap-2">
                    <div>
                        <h1 class="font-display font-extrabold text-2xl md:text-3xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-sky-200 to-amber-300 tracking-wide">
                            CHIẾN BINH KHÔNG GIAN: XƯỞNG CHIẾN CƠ & VŨ KHÍ
                        </h1>
                        <p class="text-xs md:text-sm text-slate-300">
                            Thiết lập Chiến Cơ, Loại Đạn và Cấp Đạn Khởi Đầu trước hoặc ngay trong trận chiến.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs bg-cyan-950 border border-cyan-500/40 text-cyan-300 px-3 py-1 rounded-full font-semibold">
                            🖥️ Giao Diện Buồng Lái Ngang Widescreen
                        </span>
                    </div>
                </div>

                <!-- Bố cục 2 Cột Ngang Cân Đối -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-auto">
                    
                    <!-- CỘT TRÁI: CHỌN 4 LOẠI MÁY BAY (XƯỞNG CHIẾN CƠ) -->
                    <div class="bg-slate-900/75 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="font-display font-extrabold text-sm md:text-base text-cyan-300 uppercase tracking-wider">
                                    ✈️ 1. CHỌN CHIẾN CƠ XUẤT KÍCH
                                </h3>
                                <span class="text-xs text-slate-400">4 Mẫu Chiến Cơ</span>
                            </div>

                            <!-- Danh sách 4 Chiến Cơ -->
                            <div id="modal-ship-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-3">
                                <!-- JS Render -->
                            </div>
                        </div>

                        <!-- Khung Xem Trước Ngoại Hình Canvas & Chỉ Số Chiến Cơ -->
                        <div class="bg-slate-950/90 border border-cyan-500/30 rounded-xl p-3 flex items-center gap-3.5">
                            <div class="w-24 h-24 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center shrink-0 relative">
                                <canvas id="shipPreviewCanvas" width="96" height="96"></canvas>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div id="preview-ship-name" class="font-display font-extrabold text-base text-cyan-300">Chim Ưng Ngân Hà</div>
                                <p id="preview-ship-desc" class="text-xs text-slate-300 leading-relaxed mt-0.5">
                                    Chiến cơ cân bằng toàn diện (100 HP, tốc độ chuẩn).
                                </p>
                                <div id="preview-ship-stats" class="flex flex-wrap gap-1.5 mt-2 text-[11px] font-semibold">
                                    <!-- Badges -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: CHỌN 4 LOẠI ĐẠN & CẤP ĐẠN KHỞI ĐẦU (1-10) -->
                    <div class="bg-slate-900/75 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="font-display font-extrabold text-sm md:text-base text-amber-300 uppercase tracking-wider">
                                    🔥 2. HỆ THỐNG ĐẠN & CẤP ĐỘ KHỞI ĐẦU
                                </h3>
                                <span class="text-xs text-slate-400">Phím tắt 1–4</span>
                            </div>

                            <!-- Danh sách 4 Loại Đạn -->
                            <div id="modal-ammo-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-3">
                                <!-- JS Render -->
                            </div>
                        </div>

                        <!-- Tùy chỉnh Cấp Đạn Khởi Đầu (1 đến 10) -->
                        <div class="bg-slate-950/90 border border-amber-500/30 rounded-xl p-3">
                            <div class="flex items-center justify-between mb-1.5">
                                <label for="start-tier-slider" class="font-display font-bold text-xs md:text-sm text-amber-300">
                                    ⚡ TÙY CHỈNH CẤP ĐẠN KHỞI ĐẦU:
                                </label>
                                <span id="start-tier-value" class="font-display font-extrabold text-sm md:text-base text-yellow-300 bg-amber-500/20 border border-amber-400/50 px-2.5 py-0.5 rounded-md">
                                    CẤP 1 / 10
                                </span>
                            </div>
                            <input id="start-tier-slider" type="range" min="1" max="10" value="1" class="cyber-slider mb-2">
                            <div class="flex justify-between text-[10px] text-slate-400 font-display font-bold">
                                <span>CẤP 1 (Đơn)</span>
                                <span>CẤP 3 (Ba tia)</span>
                                <span>CẤP 5 (Tỏa 5)</span>
                                <span>CẤP 8 (Siêu cấp)</span>
                                <span>CẤP 10 (Tối thượng)</span>
                            </div>
                        </div>

                        <!-- Hướng dẫn vật phẩm & điều khiển tóm tắt -->
                        <div class="mt-2.5 bg-slate-950/60 border border-slate-800 rounded-lg p-2.5 text-xs text-slate-300 grid grid-cols-3 gap-2">
                            <div>⚡ <strong class="text-yellow-300">(U) Nâng Đạn:</strong> Tăng cấp đạn (Tối đa 10)</div>
                            <div>💚 <strong class="text-emerald-300">(H) Hồi Phục:</strong> Hồi HP cho chiến cơ</div>
                            <div>🛡️ <strong class="text-cyan-300">(S) Lá Chắn:</strong> Chặn 1 đòn sát thương</div>
                        </div>
                    </div>
                </div>

                <!-- Nút Hành Động Cuối Modal -->
                <div class="flex flex-wrap items-center justify-end gap-3 pt-3 mt-3 border-t border-slate-800">
                    <button id="resume-from-hangar-btn" class="cyber-btn cyber-btn-secondary px-5 py-2.5 text-sm hidden">
                        ↩️ TIẾP TỤC TRẬN ĐẤU HIỆN TẠI
                    </button>
                    <button id="launch-mission-btn" class="cyber-btn cyber-btn-primary px-8 py-2.5 text-base">
                        🚀 XUẤT KÍCH CHIẾN DỊCH MỚI
                    </button>
                </div>
            </div>
        </div>

        <!-- ==================== MÀN HÌNH TẠM DỪNG (PAUSE OVERLAY) ==================== -->
        <div id="pause-modal" class="stage-overlay hidden-overlay">
